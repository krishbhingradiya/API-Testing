{
  "name": "task-manager-api",
  "version": "1.0.0",
  "description": "RESTful API built with Node.js and Express featuring middleware pipeline, CRUD endpoints, and centralized error handling.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node --watch server.js",
    "client": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"API,VITE\" -c \"blue,cyan\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix frontend run build",
    "test": "node test-api.js",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "express",
    "nodejs",
    "rest-api",
    "middleware",
    "crud"
  ],
  "author": "ADWF Practical 4",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "mongoose": "^9.9.1",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^11.2.0"
  }
}
