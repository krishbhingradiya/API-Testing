# Root .gitignore for multi-project repository

# Node dependencies
node_modules/
*/node_modules/

# Production builds
dist/
dist-ssr/
*/dist/
build/
*/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env
.env.local
.env.*.local
*.local

# System & Editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

